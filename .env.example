# =============================================================================
# matrix-maintainer environment reference
# Copy to .env and fill in. NEVER commit a real key.
# =============================================================================

# --- GitHub control plane ----------------------------------------------------
GITHUB_TOKEN=                # PAT with repo + workflow scope (admin operations)
CROSS_REPO_TOKEN=            # optional: separate token for dispatching to other repos
GITHUB_ORG=agent-matrix
GITHUB_BASE_BRANCH=main
WORKER_WORKFLOW_FILE=matrix-maintainer.yml

# --- OllaBridge Cloud (the LLM gateway) --------------------------------------
# All AI calls in matrix-maintainer (planner, GitPilot, ad-hoc completions)
# route through OllaBridge. The admin dashboard issues bearer tokens with the
# prefix `ob_`. Treat the key like a password -- never commit it.
OLLABRIDGE_BASE_URL=https://api.ollabridge.com/v1
OLLABRIDGE_API_KEY=          # ob_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OLLABRIDGE_MODEL=qwen2.5:7b  # any catalog id available on your OllaBridge tenant
OLLABRIDGE_TIMEOUT_SECONDS=120
OLLABRIDGE_ORGANIZATION=     # optional OpenAI-Organization passthrough

# --- SelfRepair adapter ------------------------------------------------------
# auto -> http if SELFREPAIR_BASE_URL is set, otherwise in-process local
SELFREPAIR_MODE=auto
SELFREPAIR_BASE_URL=         # e.g. https://selfrepair.internal
SELFREPAIR_API_KEY=          # bearer token if the SelfRepair service requires it
SELFREPAIR_TIMEOUT_SECONDS=120

# --- GitPilot ----------------------------------------------------------------
# GitPilot speaks OpenAI; we transparently route it through OllaBridge by
# injecting OPENAI_BASE_URL / OPENAI_API_KEY from the OLLABRIDGE_* vars above.
GITPILOT_BIN=gitpilot
GITPILOT_ENABLED=true
GITPILOT_MESSAGE_MODEL=      # if unset, OLLABRIDGE_MODEL is used
GITPILOT_MODE=auto
GITPILOT_PROVIDER=openai

# --- MatrixLab sandbox -------------------------------------------------------
MATRIXLAB_BIN=matrixlab
MATRIXLAB_ENABLED=true
MATRIXLAB_FALLBACK_LOCAL=true

# --- Agent-Matrix services ---------------------------------------------------
MATRIX_AI_ENDPOINT=http://matrix-ai.internal/plan
MATRIX_GUARDIAN_ENDPOINT=http://matrix-guardian.internal/approve
MATRIX_TREASURY_ENDPOINT=http://matrix-treasury.internal/budget
MATRIX_HUB_ENDPOINT=http://matrix-hub.internal/events

# --- Storage paths -----------------------------------------------------------
WORK_DIR=work
STATE_DIR=state
STATUS_SITE_DIR=status-site
MCP_STATE_DIR=state/mcp
PATCHES_STATE_DIR=state/patches
PERSISTENCE_DB_URL=sqlite:///state/matrix_maintainer.db

# --- Patch archive backends (Phase 4) ----------------------------------------
PATCHES_GITHUB_REPO=agent-matrix/mcp-patches
PATCHES_GITHUB_BRANCH=main
PATCHES_HF_REPO=             # e.g. agent-matrix/mcp-patches
PATCHES_HF_TOKEN=            # Hugging Face write token
PATCHES_R2_BUCKET=           # Cloudflare R2 bucket name
PATCHES_R2_ENDPOINT=         # https://<account>.r2.cloudflarestorage.com
PATCHES_R2_ACCESS_KEY=
PATCHES_R2_SECRET_KEY=

# --- Behaviour ---------------------------------------------------------------
MAX_FIX_ATTEMPTS=3
MAX_AUTOFIX_FILES=10
ALLOW_AUTOFIX_PR=true
ALLOW_DIRECT_PUSH=false
LOG_LEVEL=INFO
SCAN_SCHEDULE_CRON=0 3 * * *

# --- Status site / dashboard -------------------------------------------------
SITE_TITLE=Matrix Maintainer
SITE_BASE_URL=
BACKEND_STATUS_URL=http://127.0.0.1:8000/status
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws

# --- Legacy / compat (kept for the daily workflow) ---------------------------
MATRIX_CODEX_EXECUTION_MODE=dispatch
MATRIX_CODEX_OPERATION=daily-maintenance
