# MVP-001 first-wave local stack — copy to .env and fill in.
#
# The ONLY real secret needed for the loop is HF_TOKEN, and it is consumed
# exclusively by OllaBridge Cloud. Everything else has safe local defaults.

# Hugging Face token — owned ONLY by OllaBridge Cloud. Leave blank to run the
# whole stack offline with OllaBridge's deterministic stub provider.
HF_TOKEN=

# OllaBridge admin master key (mints ob_test_/ob_live_ client keys).
OLLAMBRIDGE_MASTER_KEY=ob_admin_localdev

# Enable Hugging Face Inference Providers in OllaBridge. When HF_TOKEN is
# blank OllaBridge falls back to a stub regardless of this flag.
OLLAMBRIDGE_ENABLE_HF_PROVIDERS=true

# Seeded agent-matrix test key — used by GitPilot and SelfRepair as their
# OPENAI_API_KEY against OllaBridge.
GITPILOT_API_KEY=ob_test_agentmatrix_xxx
SELFREPAIR_API_KEY=ob_test_agentmatrix_xxx

# MatrixLab: keep stub/dry-run execution on for safe local runs.
MATRIXLAB_DRY_RUN=1
MATRIXLAB_TOKEN=dev_matrixlab_token

# Override these if your repos are not checked out as siblings of
# matrix-maintainer (paths are relative to this compose file).
# OLLABRIDGE_CONTEXT=../../../ollabridge-cloud
# MATRIXLAB_CONTEXT=../../../matrixlab
# GITPILOT_CONTEXT=../../../gitpilot
# SELFREPAIR_CONTEXT=../../../SelfRepair
